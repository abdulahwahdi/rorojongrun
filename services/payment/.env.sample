# Basic Candi env configuration
ENVIRONMENT=development #development,staging,production
DEBUG_MODE=true
LOAD_CONFIG_TIMEOUT=20s

# Application Service Handlers
## Server
USE_REST=true
USE_GRPC=true
USE_GRAPHQL=false
## Worker
USE_KAFKA_CONSUMER=false # static topics; payment consumes DB-configured topics through USE_CALLBACK_CONSUMER instead
USE_CRON_SCHEDULER=true # static scheduler
USE_REDIS_SUBSCRIBER=false # dynamic scheduler
USE_TASK_QUEUE_WORKER=false
USE_POSTGRES_LISTENER_WORKER=false
USE_RABBITMQ_CONSUMER=false # event driven handler and dynamic scheduler

# use shared listener setup shared port to http & grpc listener (if true, use HTTP_PORT value)
USE_SHARED_LISTENER=false
HTTP_PORT=8030
GRPC_PORT=8032

TASK_QUEUE_DASHBOARD_PORT=8080
TASK_QUEUE_DASHBOARD_MAX_CLIENT=5

GRAPHQL_DISABLE_INTROSPECTION=false
HTTP_ROOT_PATH=""

# internal key of the gRPC API other services call (they send base64 of user:pass)
BASIC_AUTH_USERNAME=user
BASIC_AUTH_PASS=pass

SQL_DB_READ_DSN=postgres://user:pass@localhost:5432/payment?sslmode=disable&TimeZone=Asia/Jakarta
SQL_DB_WRITE_DSN=postgres://user:pass@localhost:5432/payment?sslmode=disable&TimeZone=Asia/Jakarta

REDIS_READ_DSN=redis://:pass@localhost:6379/0
REDIS_WRITE_DSN=redis://:pass@localhost:6379/0

KAFKA_BROKERS=localhost:9092 # if multiple broker, separate by comma with no space
KAFKA_CLIENT_VERSION=2.0.0
KAFKA_CLIENT_ID=payment
KAFKA_CONSUMER_GROUP=payment

# RABBITMQ_BROKER=amqp://guest:guest@localhost:5672/test
# RABBITMQ_CONSUMER_GROUP=payment
# RABBITMQ_EXCHANGE_NAME=delayed

OTEL_TRACING_HOST=127.0.0.1:4317

MAX_GOROUTINES=10

# Additional env for your service
## checkout: the payment link handed to callers is <CHECKOUT_BASE_URL>/<token> (the frontend calls GET /v1/checkout/<token> ...)
CHECKOUT_BASE_URL=http://localhost:3000/pay
DEFAULT_PAYMENT_EXPIRY=24h

## gateway credentials are stored AES-GCM encrypted in the DB with this secret.
## Changing it makes stored credentials unreadable: enter them again afterwards.
GATEWAY_ENCRYPTION_SECRET=change-me-to-a-long-random-string

## gateway callbacks: Kafka topics are read from the payment_kafka_topics table and hot-reloaded
USE_CALLBACK_CONSUMER=true
CALLBACK_CONSUMER_GROUP=payment-callback
CALLBACK_TOPIC_RELOAD_INTERVAL=30s

## authentication / authorization comes from the user service (see services/user/docs/realms-and-rbac.md)
ISSUER_BASE_URL=http://localhost:8000
USER_HTTP_HOST=http://localhost:8000
USER_GRPC_HOST=localhost:8002
USER_BASIC_AUTH_KEY=
