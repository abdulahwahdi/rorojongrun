{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["referenceId", "amount"],
  "properties": {
    "source": { "type": "string", "maxLength": 100 },
    "referenceId": { "type": "string", "minLength": 1, "maxLength": 100 },
    "description": { "type": "string", "maxLength": 500 },
    "amount": { "type": "integer", "minimum": 1 },
    "currency": { "type": "string", "enum": ["IDR"] },
    "customer": {
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 200 },
        "email": { "type": "string", "maxLength": 200 },
        "phone": { "type": "string", "maxLength": 30 }
      },
      "additionalProperties": false
    },
    "items": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "required": ["name", "price", "quantity"],
        "properties": {
          "name": { "type": "string", "minLength": 1, "maxLength": 200 },
          "price": { "type": "integer", "minimum": 0 },
          "quantity": { "type": "integer", "minimum": 1 }
        },
        "additionalProperties": false
      }
    },
    "metadata": { "type": "object" },
    "allowedMethods": { "type": "array", "items": { "type": "string" }, "maxItems": 50 },
    "expiresInSec": { "type": "integer", "minimum": 60, "maximum": 2592000 },
    "successUrl": { "type": "string", "maxLength": 1000 },
    "failureUrl": { "type": "string", "maxLength": 1000 }
  },
  "additionalProperties": false
}
