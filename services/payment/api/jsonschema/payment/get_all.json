{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "page": { "type": "integer", "minimum": 0 },
    "limit": { "type": "integer", "minimum": 0, "maximum": 200 },
    "search": { "type": "string" },
    "orderBy": { "type": "string" },
    "sort": { "type": "string" },
    "showAll": { "type": "boolean" },
    "source": { "type": "string" },
    "referenceId": { "type": "string" },
    "status": { "type": "string", "enum": ["", "pending", "processing", "paid", "expired", "cancelled"] },
    "methodCode": { "type": "string" },
    "startDate": { "type": "string" },
    "endDate": { "type": "string" }
  }
}
