{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "name": { "type": "string", "maxLength": 200 },
    "address": { "type": "string", "maxLength": 500 },
    "taxId": { "type": "string", "maxLength": 50 },
    "orderPrefix": { "type": "string", "pattern": "^[A-Za-z0-9]{0,10}$" },
    "invoicePrefix": { "type": "string", "pattern": "^[A-Za-z0-9]{0,10}$" },
    "creditNotePrefix": { "type": "string", "pattern": "^[A-Za-z0-9]{0,10}$" },
    "taxName": { "type": "string", "maxLength": 30 },
    "taxRate": { "type": "number", "minimum": 0, "maximum": 100 },
    "taxMode": { "type": "string", "enum": ["", "none", "inclusive", "exclusive"] },
    "roundingMode": { "type": "string", "enum": ["", "none", "nearest", "up", "down"] },
    "roundingUnit": { "type": "integer", "minimum": 0, "maximum": 1000000 },
    "timezone": { "type": "string", "maxLength": 64 }
  },
  "additionalProperties": false
}
