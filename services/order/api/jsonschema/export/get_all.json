{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "page": { "type": "integer", "minimum": 0 },
    "limit": { "type": "integer", "minimum": 0, "maximum": 200 },
    "search": { "type": "string" },
    "orderBy": { "type": "string", "enum": ["", "created_at", "updated_at"] },
    "sort": { "type": "string" },
    "showAll": { "type": "boolean" },
    "type": { "type": "string", "enum": ["", "orders", "order_lines", "invoices"] },
    "status": { "type": "string", "enum": ["", "queued", "running", "completed", "failed", "cancelled", "expired"] }
  }
}
