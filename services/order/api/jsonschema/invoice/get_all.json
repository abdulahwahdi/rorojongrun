{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "page": { "type": "integer", "minimum": 0 },
    "limit": { "type": "integer", "minimum": 0, "maximum": 200 },
    "search": { "type": "string" },
    "orderBy": { "type": "string", "enum": ["", "issued_at", "number", "total_amount"] },
    "sort": { "type": "string" },
    "showAll": { "type": "boolean" },
    "dateFrom": { "type": "string" },
    "dateTo": { "type": "string" },
    "type": { "type": "string", "enum": ["", "invoice", "credit_note"] },
    "status": { "type": "string", "enum": ["", "issued", "credited"] },
    "merchantId": { "type": "string" },
    "outletId": { "type": "string" },
    "orderId": { "type": "integer", "minimum": 0 }
  }
}
