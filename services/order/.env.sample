# Basic Candi env configuration
ENVIRONMENT=development #development,staging,production
DEBUG_MODE=true
LOAD_CONFIG_TIMEOUT=20s

# Application Service Handlers
## Server
USE_REST=true
USE_GRPC=false
USE_GRAPHQL=false # off in this service, REST only
## Worker
USE_KAFKA_CONSUMER=true # books the payment service's payment.* events
USE_CRON_SCHEDULER=true # required: outbox flush, export sweeper and purge
USE_REDIS_SUBSCRIBER=false # dynamic scheduler
USE_TASK_QUEUE_WORKER=true # required: generates CSV exports (run it where the REST API runs)
USE_POSTGRES_LISTENER_WORKER=false
USE_RABBITMQ_CONSUMER=false # event driven handler and dynamic scheduler

# use shared listener setup shared port to http & grpc listener (if true, use HTTP_PORT value)
USE_SHARED_LISTENER=false
HTTP_PORT=8040
GRPC_PORT=8042

TASK_QUEUE_DASHBOARD_PORT=8041
TASK_QUEUE_DASHBOARD_MAX_CLIENT=5

GRAPHQL_DISABLE_INTROSPECTION=false
HTTP_ROOT_PATH=""

BASIC_AUTH_USERNAME=user
BASIC_AUTH_PASS=pass

MONGODB_HOST_WRITE=mongodb://user:pass@localhost:27017/order?authSource=admin
MONGODB_HOST_READ=mongodb://user:pass@localhost:27017/order?authSource=admin

SQL_DB_READ_DSN=postgres://user:pass@localhost:5432/order?sslmode=disable&TimeZone=Asia/Jakarta
SQL_DB_WRITE_DSN=postgres://user:pass@localhost:5432/order?sslmode=disable&TimeZone=Asia/Jakarta

REDIS_READ_DSN=redis://:pass@localhost:6379/0
REDIS_WRITE_DSN=redis://:pass@localhost:6379/0

KAFKA_BROKERS=localhost:9092 # if multiple broker, separate by comma with no space
KAFKA_CLIENT_VERSION=2.0.0
KAFKA_CLIENT_ID=order
KAFKA_CONSUMER_GROUP=order

# RABBITMQ_BROKER=amqp://guest:guest@localhost:5672/test
# RABBITMQ_CONSUMER_GROUP=order
# RABBITMQ_EXCHANGE_NAME=delayed

OTEL_TRACING_HOST=127.0.0.1:4317

MAX_GOROUTINES=10

# Additional env for your service
# payment.* topics of the payment service (comma separated); the handler dispatches on the payload's "event"
PAYMENT_EVENT_TOPICS=payment.created,payment.checkout_started,payment.completed,payment.expired,payment.cancelled
# customer emails (invoice / credit note) are asked for on this topic, consumed by the notification service
ORDER_NOTIFICATION_TOPIC=notification.requested
# the audit trail of every order change goes to this topic, consumed by the activity service
ORDER_ACTIVITY_TOPIC=activity.requested

# CSV exports: where files live (a volume shared by every replica), how long they can be downloaded, the max rows
EXPORT_STORAGE_DIR=./storage/exports
EXPORT_RETENTION=168h
ORDER_EXPORT_MAX_ROWS=100000

# Token validation and permission checks go through the user service (globalshared/auth)
ISSUER_BASE_URL=http://localhost:8000
USER_HTTP_HOST=http://localhost:8000
USER_GRPC_HOST=localhost:8002
USER_BASIC_AUTH_KEY=
