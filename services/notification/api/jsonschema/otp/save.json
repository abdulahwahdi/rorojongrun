{
	"$schema": "http://json-schema.org/draft-07/schema",
	"title": "JSON Schema for request otp",
	"type": "object",
	"properties": {
		"recipient": {
			"type": "string",
			"minLength": 1
		},
		"channel": {
			"type": "string",
			"enum": ["email", "push"]
		},
		"purpose": {
			"type": "string",
			"minLength": 1
		}
	},
	"required": [ "recipient", "channel", "purpose" ],
	"additionalProperties": false
}
