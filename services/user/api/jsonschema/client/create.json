{
	"$schema": "http://json-schema.org/draft-07/schema",
	"title": "JSON Schema for create client",
	"type": "object",
	"properties": {
		"clientId": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{1,99}$" },
		"name": { "type": "string", "maxLength": 255 },
		"description": { "type": "string" },
		"type": { "type": "string", "enum": ["", "public", "confidential"] },
		"grantTypes": { "type": "array", "items": { "type": "string", "enum": ["password", "refresh_token", "client_credentials", "otp"] } },
		"enabled": { "type": ["boolean", "null"] }
	},
	"required": ["clientId"],
	"additionalProperties": false
}
