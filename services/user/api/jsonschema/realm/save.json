{
	"$schema": "http://json-schema.org/draft-07/schema",
	"title": "JSON Schema for create realm",
	"type": "object",
	"properties": {
		"name": { "type": "string", "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$" },
		"displayName": { "type": "string", "maxLength": 255 },
		"enabled": { "type": "boolean" },
		"accessTokenTtlSec": { "type": "integer", "minimum": 30 },
		"refreshTokenTtlSec": { "type": "integer", "minimum": 60 },
		"maxFailedAttempts": { "type": "integer", "minimum": 1 },
		"lockoutSec": { "type": "integer", "minimum": 0 },
		"otpLoginEnabled": { "type": "boolean" }
	},
	"required": ["name"],
	"additionalProperties": false
}
