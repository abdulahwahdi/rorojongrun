{
	"$schema": "http://json-schema.org/draft-07/schema",
	"title": "JSON Schema for the token endpoint",
	"type": "object",
	"properties": {
		"grantType": { "type": "string", "enum": ["password", "refresh_token", "client_credentials", "otp"] },
		"clientId": { "type": "string", "minLength": 1 },
		"clientSecret": { "type": "string" },
		"username": { "type": "string" },
		"password": { "type": "string" },
		"refreshToken": { "type": "string" },
		"email": { "type": "string" },
		"code": { "type": "string" }
	},
	"required": ["grantType", "clientId"],
	"allOf": [
		{ "if": { "properties": { "grantType": { "const": "password" } } }, "then": { "required": ["username", "password"] } },
		{ "if": { "properties": { "grantType": { "const": "refresh_token" } } }, "then": { "required": ["refreshToken"] } },
		{ "if": { "properties": { "grantType": { "const": "client_credentials" } } }, "then": { "required": ["clientSecret"] } },
		{ "if": { "properties": { "grantType": { "const": "otp" } } }, "then": { "required": ["email", "code"] } }
	],
	"additionalProperties": false
}
