{
	"$schema": "http://json-schema.org/draft-07/schema",
	"title": "JSON Schema for a login OTP request",
	"type": "object",
	"properties": {
		"clientId": { "type": "string", "minLength": 1 },
		"email": { "type": "string", "minLength": 3 }
	},
	"required": ["clientId", "email"],
	"additionalProperties": false
}
