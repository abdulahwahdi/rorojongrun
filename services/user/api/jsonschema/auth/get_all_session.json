{
	"$schema": "http://json-schema.org/draft-07/schema",
	"title": "JSON Schema for get all session",
	"type": "object",
	"properties": {
		"page": { "type": "number", "default": 1, "minimum": 0 },
		"limit": { "type": "number", "default": 10, "minimum": 1 },
		"orderBy": { "type": "string", "enum": ["", "id", "user_id", "created_at", "expires_at"] },
		"sort": { "type": "string", "enum": ["", "asc", "desc", "ASC", "DESC"] },
		"search": { "type": "string" },
		"userId": { "type": ["integer", "null"] },
		"activeOnly": { "type": "boolean" }
	},
	"additionalProperties": true
}
